	"compatibility_date": "2025-03-27",
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
		{
		"binding": "USERS_NOTIFICATION_CONFIG",
		"id": "611a96b027a24a9cbea070f3c2930761"
		}
	]
}
